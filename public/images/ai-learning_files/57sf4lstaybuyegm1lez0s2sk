osting/components/hiring-credits-subheader":{i18n_credits_balance_subheader:'Du har en <span class="job-posting-hiring-credits-subheader__credits-balance t-bold"> {:hiringCreditsBalance} Premium-kreditt</span> fra og med {:currentDate}.',i18n_credit_renewal:"Kreditten fornyes den {:creditRenewalDate}.",i18n_premium_credits_balance_subheader:'Du har <span class="job-posting-hiring-credits-subheader__credits-balance t-bold">{:hiringCreditsBalance}-kreditt</span> som en del av Premium-abonnementet ditt fra og med {:currentDate}.',i18n_credits_balance_description:"Denne kreditten gjelder for alle promoterte stillinger, og eventuell gjenværende saldo blir belastet kortet ditt.",i18n_credits_balance_tooltip_header:"Premium kreditt",i18n_credits_balance_tooltip_text:"Som Premium-abonnent får du en kreditt på {:creditAmountPerMonth} per måned, opptil {:creditAmountTotal} totalt. Den brukes automatisk på din neste regning."},"job-posting/components/job-card":{i18n_job_card_save_draft_label:'Lagret som <span class="t-bold">utkast</span>',i18n_job_card_active_label:"Aktiv",i18n_job_card_in_review_label:"Til gjennomgang",i18n_job_card_paused_label:"Midlertidig stoppet",i18n_job_card_secondary_description_text:"{:companyName} · {:jobLocation}"},"job-posting/components/job-preview":{i18n_job_card_with_preview_label:"Forhåndsvisning",i18n_job_card_with_preview_modal_header_title:"Forhåndsvis stillingsutlysning",i18n_job_card_with_preview_posted_by:"Utlyst av",i18n_job_card_with_preview_hint_text:"Dette er en forhåndsvisning av hvordan stillingsutlysningen din vil se ut for jobbsøkerne. Kandidatene vil svare på screeningsspørsmål når de søker.",i18n_job_card_with_preview_hint_text_hirer_account_age:"Dette er en forhåndsvisning av hvordan stillingsutlysningen din vil se ut for jobbsøkere. Detaljer om stillingen din som bedriftens størrelse og adresse, samt informasjon om når du opprettet LinkedIn-profilen din er inkludert. Kandidatene vil svare på screeningsspørsmål når de søker.",i